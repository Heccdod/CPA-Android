--- /dev/null
+++ b/sdk/cliproxy/antigravity_models_probe_timeout_test.go
@@ -0,0 +1,92 @@
+package cliproxy
+
+import (
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+// A catalog probe that waits forever on the upstream used to hold one of the five
+// probe slots for the lifetime of the process, so five stalled accounts stopped every
+// later refresh from ever running. The probe client now has a timeout, and this test
+// pins it: an upstream that accepts the request and then says nothing must end the
+// probe as a transient error instead of parking the goroutine.
+func TestAntigravityProbeClientHonoursItsTimeout(t *testing.T) {
+	resetAntigravityCapabilityCache()
+	defer resetAntigravityCapabilityCache()
+
+	previous := antigravityProbeTimeout
+	antigravityProbeTimeout = 200 * time.Millisecond
+	defer func() { antigravityProbeTimeout = previous }()
+
+	transport := http.DefaultTransport
+	defer func() { http.DefaultTransport = transport }()
+	released := make(chan struct{})
+	// The handler blocks until the client gives up, which is exactly the behaviour the
+	// timeout must interrupt. It reports that it saw the cancellation through ctx.
+	http.DefaultTransport = antigravityReviewTransport(func(r *http.Request) (*http.Response, error) {
+		defer close(released)
+		<-r.Context().Done()
+		return nil, r.Context().Err()
+	})
+
+	svc := &Service{cfg: &config.Config{}, coreManager: coreauth.NewManager(nil, nil, nil)}
+	auth := antigravityTestAuth("probe-timeout", "https://probe.invalid")
+
+	start := time.Now()
+	hints, status := svc.probeAntigravityModelCapabilityHints(t.Context(), auth, []string{"https://probe.invalid"}, "", "token", "ua")
+	elapsed := time.Since(start)
+
+	if status != antigravityProbeStatusTransientError {
+		t.Errorf("stalled probe status = %v, want a transient error", status)
+	}
+	if hints.ModelIDs != nil {
+		t.Errorf("stalled probe returned model hints: %v", hints.ModelIDs)
+	}
+	if elapsed > 5*time.Second {
+		t.Errorf("stalled probe took %v; the client timeout is not being applied", elapsed)
+	}
+	if elapsed < antigravityProbeTimeout {
+		t.Errorf("stalled probe returned after %v, before its %v timeout", elapsed, antigravityProbeTimeout)
+	}
+	select {
+	case <-released:
+	default:
+		t.Error("the probe transport was never cancelled")
+	}
+}
+
+// The timeout must not interfere with a probe that answers normally.
+func TestAntigravityProbeAcceptsAFastCatalog(t *testing.T) {
+	resetAntigravityCapabilityCache()
+	defer resetAntigravityCapabilityCache()
+
+	transport := http.DefaultTransport
+	defer func() { http.DefaultTransport = transport }()
+	http.DefaultTransport = antigravityReviewTransport(func(r *http.Request) (*http.Response, error) {
+		body := `{"models":{"gemini-3-pro-preview":{},"claude-sonnet-5":{}}}`
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     http.Header{"Content-Type": []string{"application/json"}},
+			Body:       io.NopCloser(strings.NewReader(body)),
+			Request:    r,
+		}, nil
+	})
+
+	svc := &Service{cfg: &config.Config{}, coreManager: coreauth.NewManager(nil, nil, nil)}
+	auth := antigravityTestAuth("probe-ok", "https://probe.invalid")
+	hints, status := svc.probeAntigravityModelCapabilityHints(t.Context(), auth, []string{"https://probe.invalid"}, "", "token", "ua")
+	if status != antigravityProbeStatusSuccess {
+		t.Fatalf("probe status = %v, want success", status)
+	}
+	for _, want := range []string{"gemini-3-pro-preview", "claude-sonnet-5"} {
+		if _, ok := hints.ModelIDs[want]; !ok {
+			t.Errorf("probe dropped %q from %v", want, hints.ModelIDs)
+		}
+	}
+}
