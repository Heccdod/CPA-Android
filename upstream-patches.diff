diff --git a/internal/registry/model_registry_suspension_deadline_test.go b/internal/registry/model_registry_suspension_deadline_test.go
new file mode 100644
index 0000000..b7259bd
--- /dev/null
+++ b/internal/registry/model_registry_suspension_deadline_test.go
@@ -0,0 +1,164 @@
+package registry
+
+import (
+	"testing"
+	"time"
+)
+
+// A single credential that fails with a request-level error still gets a cooldown
+// deadline from the conductor. While that deadline is live the model must stay
+// listed - a request then reaches scheduling and receives the retry hint instead of
+// "model not found" - and once it lapses the model must come back on its own,
+// without a restart and without waiting for another projection.
+func TestBoundedSuspensionKeepsSoleCredentialModelListed(t *testing.T) {
+	r := newTestModelRegistry()
+	models := []*ModelInfo{
+		{ID: "claude-sonnet-5", OwnedBy: "anthropic", Type: "claude"},
+		{ID: "claude-opus-5-5", OwnedBy: "anthropic", Type: "claude"},
+	}
+	r.RegisterClient("solo", "claude", models)
+	_, epoch := r.GetModelsAndEpochForClient("solo")
+
+	until := time.Now().Add(30 * time.Minute)
+	if !r.ApplyClientModelProjections("solo", epoch, 1, []ClientModelProjection{
+		{ModelID: "claude-sonnet-5", Suspended: true, SuspendReason: "unauthorized", SuspendUntil: until},
+		{ModelID: "claude-opus-5-5", Suspended: true, SuspendReason: "unauthorized", SuspendUntil: until},
+	}) {
+		t.Fatal("failed to apply the bounded suspension")
+	}
+	if got := len(r.GetAvailableModels("claude")); got != len(models) {
+		t.Errorf("/v1/models lists %d models during a bounded cooldown, want %d", got, len(models))
+	}
+	if got := len(r.GetAvailableModelsByProvider("claude")); got != len(models) {
+		t.Errorf("provider catalog lists %d models during a bounded cooldown, want %d", got, len(models))
+	}
+	if got := len(r.GetAvailableModelInfos()); got != len(models) {
+		t.Errorf("metadata catalog lists %d models during a bounded cooldown, want %d", got, len(models))
+	}
+	if got := r.GetModelCount("claude-sonnet-5"); got != 0 {
+		t.Errorf("a cooling credential still counts as an available client: count=%d", got)
+	}
+
+	// Move the deadline into the past: the suspension is over even though the map
+	// entry is still there, because nothing but the next projection clears it.
+	registration := r.models["claude-sonnet-5"]
+	registration.SuspendedUntil["solo"] = time.Now().Add(-time.Second)
+	registration = r.models["claude-opus-5-5"]
+	registration.SuspendedUntil["solo"] = time.Now().Add(-time.Second)
+	r.invalidateAvailableModelsCacheLocked()
+
+	if got := len(r.GetAvailableModels("claude")); got != len(models) {
+		t.Errorf("/v1/models lists %d models after the cooldown lapsed, want %d", got, len(models))
+	}
+	if got := r.GetModelCount("claude-sonnet-5"); got != 1 {
+		t.Errorf("a lapsed cooldown still removes the client: count=%d", got)
+	}
+}
+
+// The recorded deadline must also bound the model list cache, otherwise a client
+// asking right after the cooldown ended keeps reading the stale empty answer.
+func TestBoundedSuspensionExpiresTheModelListCache(t *testing.T) {
+	r := newTestModelRegistry()
+	r.RegisterClient("solo", "claude", []*ModelInfo{{ID: "claude-sonnet-5", OwnedBy: "anthropic", Type: "claude"}})
+	_, epoch := r.GetModelsAndEpochForClient("solo")
+
+	until := time.Now().Add(250 * time.Millisecond)
+	if !r.ApplyClientModelProjections("solo", epoch, 1, []ClientModelProjection{
+		{ModelID: "claude-sonnet-5", Suspended: true, SuspendReason: "request failed", SuspendUntil: until},
+	}) {
+		t.Fatal("failed to apply the bounded suspension")
+	}
+	if got := len(r.GetAvailableModels("claude")); got != 1 {
+		t.Fatalf("/v1/models lists %d models, want 1", got)
+	}
+	cache, ok := r.availableModelsCache["claude"]
+	if !ok {
+		t.Fatal("the model list was not cached at all")
+	}
+	if cache.expiresAt.IsZero() || cache.expiresAt.After(until) {
+		t.Errorf("model list cache expires at %v, want it bounded by the suspension deadline %v", cache.expiresAt, until)
+	}
+}
+
+// A suspension with no deadline - a manual one, or one whose recovery instant is
+// unknown - still hides the model once no effective client is left. This is the
+// behaviour the registry always had and the conductor relies on.
+func TestOpenEndedSuspensionStillHidesTheModel(t *testing.T) {
+	r := newTestModelRegistry()
+	r.RegisterClient("solo", "claude", []*ModelInfo{{ID: "claude-sonnet-5", OwnedBy: "anthropic", Type: "claude"}})
+	_, epoch := r.GetModelsAndEpochForClient("solo")
+
+	if !r.ApplyClientModelProjections("solo", epoch, 1, []ClientModelProjection{
+		{ModelID: "claude-sonnet-5", Suspended: true, SuspendReason: "manual"},
+	}) {
+		t.Fatal("failed to apply the open-ended suspension")
+	}
+	if got := len(r.GetAvailableModels("claude")); got != 0 {
+		t.Errorf("/v1/models lists %d models under an open-ended suspension, want 0", got)
+	}
+	if got := len(r.GetAvailableModelsByProvider("claude")); got != 0 {
+		t.Errorf("provider catalog lists %d models under an open-ended suspension, want 0", got)
+	}
+}
+
+// Resuming, unregistering and re-registering must not leave a deadline behind: a
+// stale future deadline would keep a later open-ended suspension listed.
+func TestSuspensionDeadlineIsDroppedWithTheSuspension(t *testing.T) {
+	r := newTestModelRegistry()
+	r.RegisterClient("solo", "claude", []*ModelInfo{{ID: "claude-sonnet-5", OwnedBy: "anthropic", Type: "claude"}})
+	_, epoch := r.GetModelsAndEpochForClient("solo")
+
+	if !r.ApplyClientModelProjections("solo", epoch, 1, []ClientModelProjection{
+		{ModelID: "claude-sonnet-5", Suspended: true, SuspendReason: "request failed", SuspendUntil: time.Now().Add(time.Hour)},
+	}) {
+		t.Fatal("failed to apply the bounded suspension")
+	}
+	registration := r.models["claude-sonnet-5"]
+	if _, ok := registration.SuspendedUntil["solo"]; !ok {
+		t.Fatal("the suspension deadline was not recorded")
+	}
+
+	_, epoch = r.GetModelsAndEpochForClient("solo")
+	if !r.ApplyClientModelProjections("solo", epoch, 2, []ClientModelProjection{{ModelID: "claude-sonnet-5"}}) {
+		t.Fatal("failed to clear the suspension")
+	}
+	if _, ok := registration.SuspendedUntil["solo"]; ok {
+		t.Error("clearing a suspension left its deadline behind")
+	}
+
+	// A manual suspension records no deadline even when a projection carried one
+	// just before it.
+	r.SuspendClientModel("solo", "claude-sonnet-5", "manual")
+	if _, ok := registration.SuspendedUntil["solo"]; ok {
+		t.Error("a manual suspension inherited a previous deadline")
+	}
+	r.ResumeClientModel("solo", "claude-sonnet-5")
+	if _, ok := registration.SuspendedUntil["solo"]; ok {
+		t.Error("resuming left a deadline behind")
+	}
+}
+
+// The projection must publish the deadline the scheduler already honours, and must
+// keep publishing none for a credential nothing will revive on its own.
+func TestClassifySuspensionUsesTheDeadline(t *testing.T) {
+	now := time.Now()
+	cases := []struct {
+		name   string
+		reason string
+		until  time.Time
+		want   suspensionState
+	}{
+		{name: "no deadline is open ended", reason: "unauthorized", want: suspensionOther},
+		{name: "future deadline is a cooldown", reason: "unauthorized", until: now.Add(time.Minute), want: suspensionCooldown},
+		{name: "lapsed deadline is over", reason: "unauthorized", until: now.Add(-time.Minute), want: suspensionNone},
+		{name: "quota without deadline stays a cooldown", reason: "credential_quota", want: suspensionCooldown},
+		{name: "quota with lapsed deadline is over", reason: "quota", until: now.Add(-time.Second), want: suspensionNone},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := classifySuspension(tc.reason, tc.until, now); got != tc.want {
+				t.Errorf("classifySuspension(%q, %v) = %v, want %v", tc.reason, tc.until, got, tc.want)
+			}
+		})
+	}
+}
