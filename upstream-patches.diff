@@ -0,0 +1,137 @@
+package executor
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+// TestAntigravityStreamAbandonsSilentUpstream covers the failure that left the Android
+// gateway unusable after a single answer: the upstream accepts the TCP and TLS handshake
+// and then sends nothing at all — not even a status line.
+//
+// Do() used to have no bound at all on that wait (client timeout 0, and the base transport
+// carries no ResponseHeaderTimeout), and the idle watchdog that does exist is created only
+// after Do() returns, so nothing could interrupt it. Meanwhile the gateway keeps writing
+// SSE keep-alives downstream, so the client sees a healthy connection that never produces
+// content.
+//
+// The bound must be short enough to matter, so the package-level value is lowered for the
+// duration of this test and restored afterwards. It is deliberately not parallel: the value
+// is shared package state.
+func TestAntigravityStreamAbandonsSilentUpstream(t *testing.T) {
+	previous := antigravityStreamResponseHeaderTimeout
+	antigravityStreamResponseHeaderTimeout = 300 * time.Millisecond
+	defer func() { antigravityStreamResponseHeaderTimeout = previous }()
+
+	// release lets the handlers return before the server is shut down: a handler blocked
+	// only on r.Context().Done() would keep httptest.Server.Close waiting until the test
+	// binary times out, because a timed-out request leaves the server-side conn alive.
+	release := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// Write nothing at all — no status line, no header, no byte — exactly like an
+		// upstream that completed the handshake and then stalled.
+		select {
+		case <-release:
+		case <-r.Context().Done():
+		}
+	}))
+	defer server.Close()
+	defer close(release)
+
+	executor := NewAntigravityExecutor(&config.Config{RequestRetry: 1})
+	started := time.Now()
+	resultCh := make(chan struct {
+		result *cliproxyexecutor.StreamResult
+		err    error
+	}, 1)
+	go func() {
+		result, errExecute := executor.ExecuteStream(context.Background(), &cliproxyauth.Auth{
+			Metadata: map[string]any{
+				"access_token": "token-123",
+				"expired":      time.Now().Add(24 * time.Hour).Format(time.RFC3339),
+				"project_id":   "project-1",
+			},
+			Attributes: map[string]string{"base_url": server.URL},
+		}, cliproxyexecutor.Request{
+			Model:   "gemini-3.7-flash",
+			Payload: []byte(`{"model":"gemini-3.7-flash","messages":[{"role":"user","content":"hello"}],"stream":true}`),
+		}, cliproxyexecutor.Options{
+			SourceFormat:   sdktranslator.FormatOpenAI,
+			ResponseFormat: sdktranslator.FormatOpenAI,
+			Stream:         true,
+		})
+		resultCh <- struct {
+			result *cliproxyexecutor.StreamResult
+			err    error
+		}{result, errExecute}
+	}()
+
+	select {
+	case got := <-resultCh:
+		if got.err == nil {
+			t.Fatal("ExecuteStream() returned no error while the upstream never sent headers")
+		}
+		if !strings.Contains(strings.ToLower(got.err.Error()), "timeout awaiting response headers") {
+			t.Fatalf("ExecuteStream() error = %v, want a response-header timeout", got.err)
+		}
+		if elapsed := time.Since(started); elapsed > 10*time.Second {
+			t.Fatalf("ExecuteStream() took %v to give up on a silent upstream", elapsed)
+		}
+	case <-time.After(20 * time.Second):
+		t.Fatal("ExecuteStream() never returned: a silent upstream still blocks the stream forever")
+	}
+}
+
+// TestAntigravityTransportResponseHeaderTimeoutIsPoolScoped pins the two properties the
+// streaming bound depends on: the timeout reaches the transport, and two requests that ask
+// for different bounds never share one pooled transport. Sharing would either drop the
+// bound for streams or impose it on non-streaming calls, whose headers only arrive once the
+// whole generation has finished.
+func TestAntigravityTransportResponseHeaderTimeoutIsPoolScoped(t *testing.T) {
+	auth := antigravityAuthWithIDAndProxy("header-timeout-auth", "")
+	cfg := &config.Config{}
+
+	const streaming = 300 * time.Millisecond
+	streamClient := newAntigravityHTTPClient(context.Background(), cfg, auth, 0, streaming)
+	plainClient := newAntigravityHTTPClient(context.Background(), cfg, auth, 0, 0)
+
+	streamTransport, ok := streamClient.Transport.(*http.Transport)
+	if !ok {
+		t.Fatalf("streaming client transport = %T, want *http.Transport", streamClient.Transport)
+	}
+	if streamTransport.ResponseHeaderTimeout != streaming {
+		t.Fatalf("streaming ResponseHeaderTimeout = %v, want %v", streamTransport.ResponseHeaderTimeout, streaming)
+	}
+
+	plainTransport, ok := plainClient.Transport.(*http.Transport)
+	if !ok {
+		t.Fatalf("non-streaming client transport = %T, want *http.Transport", plainClient.Transport)
+	}
+	if plainTransport.ResponseHeaderTimeout != 0 {
+		t.Fatalf("non-streaming ResponseHeaderTimeout = %v, want 0 (unset)", plainTransport.ResponseHeaderTimeout)
+	}
+	if streamTransport == plainTransport {
+		t.Fatal("transports with different response-header timeouts must not share a pool")
+	}
+
+	// A non-positive value must leave whatever the base transport configured alone, so an
+	// operator who set their own bound through the request context is not silently reset.
+	base := defaultAntigravityBaseTransport().Clone()
+	base.ResponseHeaderTimeout = 45 * time.Second
+	kept := antigravityHTTP11Transport(auth, base, 0, cfg)
+	if kept == nil {
+		t.Fatal("expected a transport for a non-nil base")
+	}
+	if kept.ResponseHeaderTimeout != 45*time.Second {
+		t.Fatalf("base ResponseHeaderTimeout = %v, want it preserved at 45s", kept.ResponseHeaderTimeout)
+	}
+}
