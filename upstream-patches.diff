+// earliestFutureInstant returns the earliest candidate that is still in the future.
+// A zero result means no candidate bounds the wait, so the caller must treat the
+// suspension as open-ended.
+func earliestFutureInstant(now time.Time, candidates ...time.Time) time.Time {
+	var earliest time.Time
+	for _, candidate := range candidates {
+		if candidate.IsZero() || !candidate.After(now) {
+			continue
+		}
+		if earliest.IsZero() || candidate.Before(earliest) {
+			earliest = candidate
+		}
 	}
+	return earliest
