    <color name="day_text_secondary">#FF6B7280</color>
    <color name="day_text_tertiary">#FF9AA1AE</color>
    <color name="day_stroke">#14000000</color>
    <color name="day_divider">#0D000000</color>
    <color name="day_ok">#FF12B76A</color>
    <color name="day_warn">#FFF79009</color>
    <color name="day_err">#FFF04438</color>
    <color name="day_switch_off">#FFD5D9E2</color>
    <color name="day_on_brand">#FFFFFFFF</color>
    <color name="day_primary_container">#FFE3E8FF</color>
